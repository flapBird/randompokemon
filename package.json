{
  "name": "random-pokemon-generator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "data:update": "tsx scripts/fetch-pokemon-data.ts",
    "data:update:offline": "tsx scripts/fetch-pokemon-data.ts --offline",
    "dev:cf": "vite dev --port 3001",
    "build:cf": "vite build",
    "preview:cf": "vite preview --port 4173",
    "test:cf": "node scripts/smoke-cloudflare.mjs",
    "deploy": "vinext-cloudflare deploy",
    "deploy:check": "cf deploy --prebuilt --mode production --dry-run",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.4",
    "@pkmn/dex": "^0.10.11",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "cf": "1.0.0-beta.21",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.0",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
